{
  "version": 8,
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f4f1e8" }
    },
    {
      "id": "green-areas",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass"],
      "paint": { "fill-color": "#cfe5c3" }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#cfe5c3" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#a9d8e6" }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a9d8e6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 3]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2, 18, 8]
      }
    },
    {
      "id": "street-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-rotation-alignment": "map",
        "text-size": 12
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#f4f1e8",
        "text-halo-width": 1
      }
    },
    {
      "id": "monument-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["in", "subclass", "monument", "castle", "ruins"],
      "layout": {
        "icon-image": ["match", ["get", "subclass"], "castle", "castle", "monument"],
        "text-anchor": "top",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-offset": [0, 0.9],
        "text-optional": true,
        "text-size": 13
      },
      "paint": {
        "text-color": "#a9430c",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "village-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": ["in", "class", "village", "hamlet"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "#f4f1e8",
        "text-halo-width": 1
      }
    },
    {
      "id": "town-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 6,
      "filter": ["==", "class", "town"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 13
      },
      "paint": {
        "text-color": "#4c4c4c",
        "text-halo-color": "#f4f1e8",
        "text-halo-width": 1
      }
    },
    {
      "id": "city-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 14
      },
      "paint": {
        "text-color": "#414141",
        "text-halo-color": "#f4f1e8",
        "text-halo-width": 1
      }
    }
  ]
}
